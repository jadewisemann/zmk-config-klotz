#define COMBO_TERM_MS 40

/* General */
#define MO_CAPS_SETTING &mo_caps_word SETTINGS 0
ZMK_COMBO(outer_thumb, MO_CAPS_SETTING,  31 32,    BASE MAC_OVERLAY, COMBO_TERM_MS)

/* Left top */
ZMK_COMBO(alt_space,   &kp LA(SPACE),     1  2      , BASE MAC_OVERLAY, COMBO_TERM_MS)
ZMK_COMBO(alt_tab,     &alt_tab_swap,        2  3   , BASE MAC_OVERLAY, COMBO_TERM_MS)
ZMK_COMBO(alt_slash,   &kp LA(SLASH),     1     3   , BASE MAC_OVERLAY, COMBO_TERM_MS)

/* Left bottom */
ZMK_COMBO(close_tab,   &kp LC(W),        21    23   , BASE            , COMBO_TERM_MS)
ZMK_COMBO(prev_tab,    &kp LC(LS(TAB)),  21 22      , BASE            , COMBO_TERM_MS)
ZMK_COMBO(next_tab,    &kp LC(TAB),         22 23   , BASE            , COMBO_TERM_MS)
ZMK_COMBO(go_back,     &kp LA(LEFT),     20 21      , BASE            , COMBO_TERM_MS)

/* macOS: left bottom */
ZMK_COMBO(m_close_tab, &kp LG(W),        21    23   ,      MAC_OVERLAY, COMBO_TERM_MS)
ZMK_COMBO(m_prev_tab,  &kp LG(LS(LBKT)), 21 22      ,      MAC_OVERLAY, COMBO_TERM_MS)
ZMK_COMBO(m_next_tab,  &kp LG(LS(RBKT)),    22 23   ,      MAC_OVERLAY, COMBO_TERM_MS)
ZMK_COMBO(m_go_back,   &kp LG(LBKT),     20 21      ,      MAC_OVERLAY, COMBO_TERM_MS)

/* Right top */
ZMK_COMBO(combo_space, &kp SPACE,         6  7      , BASE MAC_OVERLAY, COMBO_TERM_MS)
ZMK_COMBO(combo_lang,  &kp LANG1,            7  8   , BASE            , COMBO_TERM_MS)

/* macOS: right top */
ZMK_COMBO(combo_lang_m, &kp F18,              7  8   ,      MAC_OVERLAY, COMBO_TERM_MS)

/* Right bottom */
#define MEH   LC(LS(LALT))
#define HYPER LG(LC(LS(LALT)))

ZMK_COMBO(alt_n,       &kp LA(N),        26 27      , BASE MAC_OVERLAY, COMBO_TERM_MS)
ZMK_COMBO(alt_comma,   &kp LA(COMMA),       27 28   , BASE MAC_OVERLAY, COMBO_TERM_MS)
ZMK_COMBO(ws_foucs,    &kp MEH,          26    28   , BASE MAC_OVERLAY, COMBO_TERM_MS)
ZMK_COMBO(ws_move,     &kp HYPER,              28 29, BASE MAC_OVERLAY, COMBO_TERM_MS)
