#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>
#include <zmk-helpers/helper.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// LAYER
#define BASE 0
#define NAV 1
#define NUM 2
#define SYM 3
#define SYM2 4
#define FUNC 5
#define FUNC2 6
#define SETTINGS 7
#define MAC_TOGGLE 8
#define MAC_OVERLAY 9
#define MAC_NAV 10
#define MAC_NUM 11
#define MAC_SYM 12
#define MAC_SYM2 13
#define MAC_FUNC 14
#define MAC_FUNC2 15

#define XXX &none
#define ___ &trans

#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29
#define THUMBS 30 31 32 33

#define QUICK_TAP_MS 100
#define TAPPING_TERM_MS 135
#define STICKY_RELEASE_MS 2000

#define ALL_LAYERS \
  BASE NAV NUM SYM SYM2 FUNC FUNC2 SETTINGS \
  MAC_TOGGLE MAC_OVERLAY MAC_NAV MAC_NUM MAC_SYM MAC_SYM2 MAC_FUNC MAC_FUNC2

#define LAYER(NAME, LT, RT, LM, RM, LB, RB, TH) \
  ZMK_LAYER(NAME, LT RT LM RM LB RB TH)

#define COMBO(NAME, BINDING, POS, TIMEOUT) \
  ZMK_COMBO(NAME, BINDING, POS, ALL_LAYERS, TIMEOUT)

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS) \
  ZMK_HOLD_TAP(NAME, bindings = <HOLD>, <TAP>; flavor = "balanced"; \
               tapping-term-ms = <280>; quick-tap-ms = <QUICK_TAP_MS>; \
               require-prior-idle-ms = <150>; hold-trigger-on-release; \
               hold-trigger-key-positions = <TRIGGER_POS>;)

#define SMART_NUM &smart_num NUM NUM

&sk {
  release-after-ms = <STICKY_RELEASE_MS>;
  quick-release;
	//ignore-modifiers;
};

&mt {
    quick-tap-ms = <QUICK_TAP_MS>;
    flavor = "tap-preferred";
    tapping-term-ms = <TAPPING_TERM_MS>;
};

&lt {
    quick-tap-ms = <QUICK_TAP_MS>;
    tapping-term-ms = <TAPPING_TERM_MS>;
};

ZMK_HOLD_TAP(qt,
	bindings = <&kp>, <&kp>;
	flavor = "hold-preferred";
	tapping-term-ms = <200>;
	quick-tap-ms = <200>;)

ZMK_HOLD_TAP(ht_bootloader,
	bindings = <&bootloader>, <&none>;
	flavor = "hold-preferred";
	tapping-term-ms = <5000>;)

MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS)
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS)

ZMK_HOLD_TAP(smart_num,
	bindings = <&mo>, <&num_word>;
	flavor = "balanced";
	tapping-term-ms = <200>;
	quick-tap-ms = <QUICK_TAP_MS>;)

ZMK_CONDITIONAL_LAYER(mac_base_mode, MAC_TOGGLE, MAC_OVERLAY)
ZMK_CONDITIONAL_LAYER(mac_nav_mode, NAV MAC_TOGGLE, MAC_NAV)
ZMK_CONDITIONAL_LAYER(mac_num_mode, NUM MAC_TOGGLE, MAC_NUM)
ZMK_CONDITIONAL_LAYER(mac_sym_mode, SYM MAC_TOGGLE, MAC_SYM)
ZMK_CONDITIONAL_LAYER(mac_sym2_mode, SYM2 MAC_TOGGLE, MAC_SYM2)
ZMK_CONDITIONAL_LAYER(mac_func_mode, FUNC MAC_TOGGLE, MAC_FUNC)
ZMK_CONDITIONAL_LAYER(mac_func2_mode, FUNC2 MAC_TOGGLE, MAC_FUNC2)

ZMK_MACRO(vsc_fcs_lf, bindings = <&kp LC(K) &kp LC(LEFT)>;)
ZMK_MACRO(vsc_fcs_dn, bindings = <&kp LC(K) &kp LC(DOWN)>;)
ZMK_MACRO(vsc_fcs_ri, bindings = <&kp LC(K) &kp LC(RIGHT)>;)
ZMK_MACRO(vsc_fcs_up, bindings = <&kp LC(K) &kp LC(UP)>;)
ZMK_MACRO(vsc_mov_lf, bindings = <&kp LC(K) &kp LEFT>;)
ZMK_MACRO(vsc_mov_dn, bindings = <&kp LC(K) &kp DOWN>;)
ZMK_MACRO(vsc_mov_ri, bindings = <&kp LC(K) &kp RIGHT>;)
ZMK_MACRO(vsc_mov_up, bindings = <&kp LC(K) &kp UP>;)

ZMK_MACRO(m_vsc_fcs_lf, bindings = <&kp LG(K) &kp LG(LEFT)>;)
ZMK_MACRO(m_vsc_fcs_dn, bindings = <&kp LG(K) &kp LG(DOWN)>;)
ZMK_MACRO(m_vsc_fcs_ri, bindings = <&kp LG(K) &kp LG(RIGHT)>;)
ZMK_MACRO(m_vsc_fcs_up, bindings = <&kp LG(K) &kp LG(UP)>;)
ZMK_MACRO(m_vsc_mov_lf, bindings = <&kp LG(K) &kp LG(LEFT)>;)
ZMK_MACRO(m_vsc_mov_dn, bindings = <&kp LG(K) &kp LG(DOWN)>;)
ZMK_MACRO(m_vsc_mov_ri, bindings = <&kp LG(K) &kp LG(RIGHT)>;)
ZMK_MACRO(m_vsc_mov_up, bindings = <&kp LG(K) &kp LG(UP)>;)

COMBO(copy, &kp LC(C), 22 12, 40)
COMBO(paste, &kp LC(V), 23 13, 40)

COMBO(l_shft, &kp LSHFT, 30 11, 50)
COMBO(l_alt, &kp LALT, 30 12, 50)
COMBO(l_ctrl, &kp LCTRL, 30 13, 50)
COMBO(l_gui, &kp LGUI, 30 14, 50)
COMBO(l_ctrl_alt, &kp LC(LALT), 30 13 12, 50)
COMBO(l_ctrl_shft, &kp LC(LSHFT), 30 13 11, 50)
COMBO(l_gui_shft, &kp LG(LSHFT), 30 14 11, 50)
COMBO(l_meh_1, &kp LC(LA(LSHFT)), 30 13 12 11, 70)
COMBO(l_meh_2, &kp LC(LA(LGUI)), 30 14 13 12, 70)
COMBO(l_meh_3, &kp LC(LG(LSHFT)), 30 14 13 11, 70)
COMBO(l_meh_4, &kp LA(LG(LSHFT)), 30 14 12 11, 70)
COMBO(l_hyper, &kp LC(LA(LG(LSHFT))), 30 14 13 12 11, 80)

COMBO(r_gui, &kp RGUI, 33 15, 50)
COMBO(r_ctrl, &kp LCTRL, 33 16, 50)
COMBO(r_alt, &kp RALT, 33 17, 50)
COMBO(r_shft, &kp RSHFT, 33 18, 50)
COMBO(r_ctrl_alt, &kp RC(RA(RALT)), 33 16 17, 50)
COMBO(r_ctrl_shft, &kp RC(RSHFT), 33 16 18, 50)
COMBO(r_gui_shft, &kp RG(RSHFT), 33 15 18, 50)
COMBO(r_meh_1, &kp RC(RA(RSHFT)), 33 16 17 18, 70)
COMBO(r_meh_2, &kp RC(RA(RGUI)), 33 15 16 17, 70)
COMBO(r_meh_3, &kp RC(RG(RSHFT)), 33 15 16 18, 70)
COMBO(r_meh_4, &kp RA(RG(RSHFT)), 33 15 17 18, 70)
COMBO(r_hyper, &kp RC(RA(RG(RSHFT))), 33 15 16 17 18, 80)

COMBO(capsword, &caps_word, 20 29, 50)
COMBO(left_thumb, &mt LGUI ESC, 30 31, 80)
COMBO(right_thumb, &kp DEL, 32 33, 80)
COMBO(settings, &mo SETTINGS, 31 32, 200)
COMBO(macos_toggle, &tog MAC_TOGGLE, 0 1 2, 100)

LAYER(Base,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
		&kp Q         &kp W         &kp E         &kp R         &kp T       ,   &kp Y         &kp U         &kp I         &kp O         &kp SLASH   ,
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
		&hml LSHFT A  &hml LALT S   &hml LCTRL D  &hml LGUI F   &kp G       ,   &kp H         &hmr LGUI J   &hmr LCTRL K  &hmr LALT L   &hmr LSHFT P ,
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
		&kp Z         &kp X         &kp C         &kp V         &kp B       ,   &kp B         &kp N         &kp M         &mt RALT COMMA &mt RSHIFT DOT,
//╰─────────────┼─────────────┴─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴───────────────────────────╯
																							&lt NAV SPACE &kp TAB         SMART_NUM     &lt SYM LANG1
//                                          ╰─────────────┴─────────────╯ ╰─────────────┴─────────────╯
	)

