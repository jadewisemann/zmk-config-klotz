LAYER(
  Sym,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp BSLH      &kp MINUS	    &kp EQUAL     &kp SEMI      &kp SQT     ,   &kp DQT       &kp COLON     &kp PLUS      &kp UNDER	    &kp PIPE    ,
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp GRAVE	    &kp LT        &kp LBRC      &kp LPAR      &kp LBKT    ,   &kp RBKT      &kp RPAR      &kp RBRC	    &kp GT        &kp TILDE   ,
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
		&kp EXCL      &kp AT_SIGN   &kp HASH      &kp DOLLAR    ___         ,   ___           &kp PERCENT   &kp CARET     &kp AMPERSAND &kp ASTERISK,
//╰─────────────┼─────────────┴─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴───────────────────────────╯
