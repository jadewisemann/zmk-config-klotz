#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// LAYER
#define BASE 0
#define NAV 1
#define SYM 2
#define FUNC 3
#define FUNC2 4
#define SETTINGS 5
#define MAC_TOGGLE 6
#define MAC_OVERLAY 7
#define MAC_NAV 8
#define MAC_FUNC 9
#define MAC_FUNC2 10

// ALIASES

&sk {
	ignore-modifiers;
};

&mt {
    quick-tap-ms = <100>;
    flavor = "tap-preferred";
    tapping-term-ms = <135>;
};

&lt {
    quick-tap-ms = <100>;
    tapping-term-ms = <135>;
};


/ {
	behaviors {
		qt: quick_tap {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <200>;
			quick-tap-ms = <200>;
			bindings = <&kp>, <&kp>;
		};

		ht_bootloader: ht_bootloader {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <5000>;
			bindings = <&bootloader>, <&none>;
		};
	};

	conditional_layers {
		compatible = "zmk,conditional-layers";

		mac_base_mode {
			if-layers = <MAC_TOGGLE>;
			then-layer = <MAC_OVERLAY>;
		};

		mac_nav_mode {
			if-layers = <NAV MAC_TOGGLE>;
			then-layer = <MAC_NAV>;
		};


		mac_func_mode {
			if-layers = <FUNC MAC_TOGGLE>;
			then-layer = <MAC_FUNC>;
		};

		mac_func2_mode {
			if-layers = <FUNC2 MAC_TOGGLE>;
			then-layer = <MAC_FUNC2>;
		};
	};

	macros {
		vsc_fcs_lf: vsc_fcs_lf {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LC(K) &kp LC(LEFT)>;
		};

		vsc_fcs_dn: vsc_fcs_dn {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LC(K) &kp LC(DOWN)>;
		};

		vsc_fcs_ri: vsc_fcs_ri {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LC(K) &kp LC(RIGHT)>;
		};

		vsc_fcs_up: vsc_fcs_up {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LC(K) &kp LC(UP)>;
		};

		vsc_mov_lf: vsc_mov_lf {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LC(K) &kp LEFT>;
		};

		vsc_mov_dn: vsc_mov_dn {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LC(K) &kp DOWN>;
		};

		vsc_mov_ri: vsc_mov_ri {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LC(K) &kp RIGHT>;
		};

		vsc_mov_up: vsc_mov_up {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LC(K) &kp UP>;
		};

		// vscode -- macos
		m_vsc_fcs_lf: m_vsc_fcs_lf {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LG(K) &kp LG(LEFT)>;
		};

		m_vsc_fcs_dn: m_vsc_fcs_dn {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LG(K) &kp LG(DOWN)>;
		};

		m_vsc_fcs_ri: m_vsc_fcs_ri {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LG(K) &kp LG(RIGHT)>;
		};

		m_vsc_fcs_up: m_vsc_fcs_up {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LG(K) &kp LG(UP)>;
		};

		m_vsc_mov_lf: m_vsc_mov_lf {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LG(K) &kp LG(LEFT)>;
		};

		m_vsc_mov_dn: m_vsc_mov_dn {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LG(K) &kp LG(DOWN)>;
		};

		m_vsc_mov_ri: m_vsc_mov_ri {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LG(K) &kp LG(RIGHT)>;
		};

		m_vsc_mov_up: m_vsc_mov_up {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LG(K) &kp LG(UP)>;
		};

		mac_screenshot: mac_screenshot {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LG(LS(N4))>;
		};
	};

	combos {
		compatible = "zmk,combos";

		combo_capsword {
			timeout-ms = <50>;
			key-positions = <20 29>;
			bindings = <&caps_word>;
		};

		combo_left_thumb {
			timeout-ms = <80>;
			key-positions = <30 31>;
			bindings = <&mt LGUI ESC>;
		};

		combo_right_thumb {
			timeout-ms = <80>;
			key-positions = <32 33>;
			bindings = <&kp DEL>;
		};

		combo_settings {
			timeout-ms = <200>;
			key-positions = <31 32>;
			bindings = <&mo SETTINGS>;
		};

		combo_macos_toggle {
			timeout-ms = <100>;
			key-positions = <0 1 2>;
			bindings = <&tog MAC_TOGGLE>;
		};
	};

	keymap {
		compatible = "zmk,keymap";
		default_layer {
		label= "BASE";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&kp Q           &kp W           &kp E           &kp R           &kp T               &kp Y           &kp U           &kp I           &kp O           &kp SLASH
				&kp A           &kp S           &kp D           &kp F           &kp G               &kp H           &kp J           &kp K           &kp L           &kp P
				&mt LSHFT Z     &mt LALT X      &kp C           &kp V           &kp B               &kp B           &kp N           &kp M           &mt RALT COMMA  &mt RSHIFT DOT
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
        &lt SYM SPACE   &mt LCTRL TAB   &lt FUNC LANG1  &lt NAV LANG1
			>;
		};

		nav_layer {
			label= "NAV";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&kp N6 		      &kp N7		      &kp NUMBER_8    &kp N9     	    &kp N0              &kp ESC         &kp TAB         &kp ENTER       &kp BACKSPACE   &kp DEL
				&kp N1          &kp N2     	    &kp N3     		  &kp N4     	    &kp N5              &kp SPACE       &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT
				&kp LSHFT 	    &kp LALT        &kp COMMA       &kp DOT         &caps_word          &kp LS(LG(S))   &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP     &kp END
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
        &trans		      &trans          &trans          &trans
			>;
		};


		sym_layer {
			label= "SYM";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&kp BSLH        &kp MINUS	      &kp EQUAL       &kp SEMI        &kp SQT             &kp DQT         &kp COLON       &kp PLUS        &kp UNDER	    &kp PIPE
				&kp GRAVE	      &kp LT          &kp LBRC        &kp LPAR        &kp LBKT            &kp RBKT        &kp RPAR        &kp RBRC	    &kp GT          &kp TILDE
				&kp EXCL        &kp AT_SIGN     &kp HASH        &kp DOLLAR      &caps_word          &kp RCTRL       &kp PERCENT     &kp CARET       &kp AMPERSAND   &kp ASTERISK
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans		      &trans          &trans		      &trans
			>;
		};

		func_layer {
			label= "FUNC";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&kp LC(W)	      &kp LC(PG_UP)   &vsc_fcs_up     &kp LC(PG_DN)   &none               &kp DOT         &kp N7          &kp N8          &kp N9          &kp ENTER
				&mo FUNC2       &vsc_fcs_lf     &vsc_fcs_dn     &vsc_fcs_ri     &none               &kp COMMA       &kp N4          &kp N5          &kp N6          &kp N0
				&none 	        &kp LC(T)       &kp LC(N)       &kp LC(LS(N))  	&none               &none           &kp N1          &kp N2          &kp N3          &none
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans		      &trans          &trans          &trans
			>;
		};

		func_2_layer {
			label= "FUNC2";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&none           &trans          &vsc_mov_up     &trans          &none               &none           &none           &none           &none           &none
				&none           &vsc_mov_lf     &vsc_mov_dn     &vsc_mov_ri     &none               &none           &none           &none           &none           &none
				&none           &none           &none           &none           &none               &none           &none           &none           &none           &none
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans          &trans          &trans          &trans
			>;
		};

		settings_layer {
			label= "SET";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&bootloader     &none           &out OUT_TOG    &bt BT_CLR      &bt BT_SEL 0        &bt BT_SEL 3    &none           &none           &tog MAC_TOGGLE &bootloader
				&none           &none           &out OUT_BLE    &none           &bt BT_SEL 1        &bt BT_SEL 4    &none           &none           &none           &none
				&studio_unlock  &none           &out OUT_USB    &none           &bt BT_SEL 2        &bt BT_SEL 5    &none           &none           &none           &studio_unlock
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&none           &none           &none           &none
			>;
		};

		mac_toggle_layer {
			label= "MAC TOGGLE";
			bindings = <
			    //              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans          &trans          &trans          &trans
			>;
		};

		mac_overlay_layer {
			label= "MAC OVERLAY";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans          &mt LGUI TAB    &lt FUNC F18    &lt NAV F18
			>;
		};

		mac_nav_layer {
			label= "MAC NAV";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans          &trans          &trans          &trans
				>;
			};


		mac_func_layer {
			label= "MAC FUNC";
			bindings = <
			    //              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&kp LG(W)       &kp LG(PG_UP)   &m_vsc_fcs_up   &kp LG(PG_DN)   &none               &none           &trans          &trans          &trans	        &trans
				&mo FUNC2       &m_vsc_fcs_lf   &m_vsc_fcs_dn   &m_vsc_fcs_ri   &none               &none           &trans          &trans          &trans          &trans
				&none           &kp LG(T)       &kp LG(N)       &kp LG(LS(N))   &none               &none           &trans          &trans          &trans          &trans
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans          &trans          &trans          &trans
			>;
			};

		mac_func2_layer {
			label= "MAC FUNC 2";
			bindings = <
                //              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&none           &trans          &m_vsc_mov_up   &trans          &none               &none           &none           &none           &none           &none
				&none           &m_vsc_mov_lf   &m_vsc_mov_dn   &m_vsc_mov_ri   &none               &none           &none           &none           &none           &none
				&none           &none           &none           &none           &none               &none           &none           &none           &none           &none
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans          &trans          &trans          &trans
			>;
		};
	};
};
