#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// LAYER
#define BASE 0
#define NAV 1
#define NUM 2
#define SYM 3
#define SYM2 4
#define FUNC 5
#define FUNC2 6
#define SETTINGS 7
#define MAC_TOGGLE 8
#define MAC_OVERLAY 9
#define MAC_NAV 9
#define MAC_NUM 10
#define MAC_SYM 11
#define MAC_SYM2 12
#define MAC_FUNC 13
#define MAC_FUNC2 14

&sk {
  release-after-ms = <2000>;
  quick-release;
	//ignore-modifiers;
};

&mt {
    quick-tap-ms = <100>;
    flavor = "tap-preferred";
    tapping-term-ms = <135>;
};

&lt {
    quick-tap-ms = <100>;
    tapping-term-ms = <135>;
};


/ {
	behaviors {
		qt: quick_tap {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <200>;
			quick-tap-ms = <200>;
			bindings = <&kp>, <&kp>;
		};

		ht_bootloader: ht_bootloader {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <5000>;
			bindings = <&bootloader>, <&none>;
		};
	};

	conditional_layers {
		compatible = "zmk,conditional-layers";

		mac_base_mode {
			if-layers = <MAC_TOGGLE>;
			then-layer = <MAC_OVERLAY>;
		};

		mac_nav_mode {
			if-layers = <NAV MAC_TOGGLE>;
			then-layer = <MAC_NAV>;
		};

		mac_num_mode {
			if-layers = <NUM MAC_TOGGLE>;
			then-layer = <MAC_NUM>;
		};
		
    mac_sym_mode {
			if-layers = <SYM MAC_TOGGLE>;
			then-layer = <MAC_SYM>;
		};
    
    mac_sym2_mode {
			if-layers = <SYM2 MAC_TOGGLE>;
			then-layer = <MAC_SYM2>;
		};

		mac_func_mode {
			if-layers = <FUNC MAC_TOGGLE>;
			then-layer = <MAC_FUNC>;
		};

		mac_func2_mode {
			if-layers = <FUNC2 MAC_TOGGLE>;
			then-layer = <MAC_FUNC2>;
		};
	};

	macros {
		vsc_fcs_lf: vsc_fcs_lf {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LC(K) &kp LC(LEFT)>;
		};

		vsc_fcs_dn: vsc_fcs_dn {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LC(K) &kp LC(DOWN)>;
		};

		vsc_fcs_ri: vsc_fcs_ri {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LC(K) &kp LC(RIGHT)>;
		};

		vsc_fcs_up: vsc_fcs_up {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LC(K) &kp LC(UP)>;
		};

		vsc_mov_lf: vsc_mov_lf {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LC(K) &kp LEFT>;
		};

		vsc_mov_dn: vsc_mov_dn {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LC(K) &kp DOWN>;
		};

		vsc_mov_ri: vsc_mov_ri {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LC(K) &kp RIGHT>;
		};

		vsc_mov_up: vsc_mov_up {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LC(K) &kp UP>;
		};

		// vscode -- macos
		m_vsc_fcs_lf: m_vsc_fcs_lf {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LG(K) &kp LG(LEFT)>;
		};

		m_vsc_fcs_dn: m_vsc_fcs_dn {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LG(K) &kp LG(DOWN)>;
		};

		m_vsc_fcs_ri: m_vsc_fcs_ri {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LG(K) &kp LG(RIGHT)>;
		};

		m_vsc_fcs_up: m_vsc_fcs_up {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LG(K) &kp LG(UP)>;
		};

		m_vsc_mov_lf: m_vsc_mov_lf {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LG(K) &kp LG(LEFT)>;
		};

		m_vsc_mov_dn: m_vsc_mov_dn {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LG(K) &kp LG(DOWN)>;
		};

		m_vsc_mov_ri: m_vsc_mov_ri {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LG(K) &kp LG(RIGHT)>;
		};

		m_vsc_mov_up: m_vsc_mov_up {
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LG(K) &kp LG(UP)>;
		};
	};

	combos {
    compatible = "zmk,combos";

    // =================================================================
    // [기능성 수직 콤보] 편집 및 도구
    // =================================================================
    // Ctrl + C (C + D 수직 조합)
    cmb_copy {
      timeout-ms = <40>;
      key-positions = <22 12>; // C(22) + D(12)
      bindings = <&kp LC(C)>;
    };

    // Ctrl + V (V + F 수직 조합)
    cmb_paste {
      timeout-ms = <40>;
      key-positions = <23 13>; // V(23) + F(13)
      bindings = <&kp LC(V)>;
    };


    // =================================================================
    // [왼쪽 손] 엄지(30) 기반 모디파이어 (1~4개 조합)
    // =================================================================
    // 단일 모디파이어
    cmb_l_shft { timeout-ms = <50>; key-positions = <30 11>; bindings = <&kp LSHFT>; };
    cmb_l_alt  { timeout-ms = <50>; key-positions = <30 12>; bindings = <&kp LALT>; };
    cmb_l_ctrl { timeout-ms = <50>; key-positions = <30 13>; bindings = <&kp LCTRL>; };
    cmb_l_gui  { timeout-ms = <50>; key-positions = <30 14>; bindings = <&kp LGUI>; };

    // 2개 조합
    cmb_l_ctrl_alt  { timeout-ms = <50>; key-positions = <30 13 12>; bindings = <&kp LC(LALT)>; };
    cmb_l_ctrl_shft { timeout-ms = <50>; key-positions = <30 13 11>; bindings = <&kp LC(LSHFT)>; };
    cmb_l_gui_shft  { timeout-ms = <50>; key-positions = <30 14 11>; bindings = <&kp LG(LSHFT)>; };

    // 3개 조합 (Meh)
    cmb_l_meh_1 { timeout-ms = <70>; key-positions = <30 13 12 11>; bindings = <&kp LC(LA(LSHFT))>; };
    cmb_l_meh_2 { timeout-ms = <70>; key-positions = <30 14 13 12>; bindings = <&kp LC(LA(LGUI))>; };
    cmb_l_meh_3 { timeout-ms = <70>; key-positions = <30 14 13 11>; bindings = <&kp LC(LG(LSHFT))>; };
    cmb_l_meh_4 { timeout-ms = <70>; key-positions = <30 14 12 11>; bindings = <&kp LA(LG(LSHFT))>; };

    // 4개 조합 (Hyper)
    cmb_l_hyper { timeout-ms = <80>; key-positions = <30 14 13 12 11>; bindings = <&kp LC(LA(LG(LSHFT)))>; };


    // =================================================================
    // [오른쪽 손] 엄지(33) 기반 모디파이어 (1~4개 조합)
    // =================================================================
    // 단일 모디파이어
    cmb_r_gui  { timeout-ms = <50>; key-positions = <33 15>; bindings = <&kp RGUI>; };
    cmb_r_ctrl { timeout-ms = <50>; key-positions = <33 16>; bindings = <&kp RCTRL>; };
    cmb_r_alt  { timeout-ms = <50>; key-positions = <33 17>; bindings = <&kp RALT>; };
    cmb_r_shft { timeout-ms = <50>; key-positions = <33 18>; bindings = <&kp RSHFT>; };

    // 2개 조합
    cmb_r_ctrl_alt  { timeout-ms = <50>; key-positions = <33 16 17>; bindings = <&kp RC(RA(RALT))>; };
    cmb_r_ctrl_shft { timeout-ms = <50>; key-positions = <33 16 18>; bindings = <&kp RC(RSHFT)>; };
    cmb_r_gui_shft  { timeout-ms = <50>; key-positions = <33 15 18>; bindings = <&kp RG(RSHFT)>; };

    // 3개 조합 (Meh)
    cmb_r_meh_1 { timeout-ms = <70>; key-positions = <33 16 17 18>; bindings = <&kp RC(RA(RSHFT))>; };
    cmb_r_meh_2 { timeout-ms = <70>; key-positions = <33 15 16 17>; bindings = <&kp RC(RA(RGUI))>; };
    cmb_r_meh_3 { timeout-ms = <70>; key-positions = <33 15 16 18>; bindings = <&kp RC(RG(RSHFT))>; };
    cmb_r_meh_4 { timeout-ms = <70>; key-positions = <33 15 17 18>; bindings = <&kp RA(RG(RSHFT))>; };

    // 4개 조합 (Hyper)
    cmb_r_hyper { timeout-ms = <80>; key-positions = <33 15 16 17 18>; bindings = <&kp RC(RA(RG(RSHFT)))>; };


    // =================================================================
    // [기존 시스템 콤보]
    // =================================================================
    cmb_capsword { timeout-ms = <50>; key-positions = <20 29>; bindings = <&caps_word>; };
    cmb_left_thumb { timeout-ms = <80>; key-positions = <30 31>; bindings = <&mt LGUI ESC>; };
    cmb_right_thumb { timeout-ms = <80>; key-positions = <32 33>; bindings = <&kp DEL>; };
    cmb_settings { timeout-ms = <200>; key-positions = <31 32>; bindings = <&mo SETTINGS>; };
    cmb_macos_toggle { timeout-ms = <100>; key-positions = <0 1 2>; bindings = <&tog MAC_TOGGLE>; };
  };

	keymap {
		compatible = "zmk,keymap";

		default_layer {
		label= "BASE";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&kp Q           &kp W           &kp E           &kp R           &kp T               &kp Y           &kp U           &kp I           &kp O           &kp SLASH
				&kp A           &kp S           &kp D           &kp F           &kp G               &kp H           &kp J           &kp K           &kp L           &kp P
				&mt LSHFT Z     &mt LALT X      &kp C           &kp V           &kp B               &kp B           &kp N           &kp M           &mt RALT COMMA  &mt RSHIFT DOT
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
        &lt NAV SPACE   &lt NUM TAB     &lt SYM2 LANG1  &lt SYM LANG1
			>;
		};
    
		nav_layer {
			label= "NAV";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&none           &none		        &none           &none     	    &none               &kp ESC         &kp TAB         &kp ENTER       &kp BACKSPACE   &kp DEL
				&none           &sk LSHFT     	&sk LALT        &sk LCTRL     	&sk LGUI            &kp SPACE       &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT
				&none           &none           &none           &none           &none               &kp LS(LG(S))   &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP     &kp END
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
        &trans 		      &trans          &trans          &trans
			>;
		};

    num_layer {
			label= "NUM";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&none           &none           &none           &none           &none               &kp DOT         &kp N7          &kp N8          &kp N9          &none
				&none           &sk LSHFT     	&sk LALT        &sk LCTRL     	&sk LGUI            &kp COMMA       &kp N4          &kp N5          &kp N6          &kp ENTER
				&none           &none           &none           &none           &none               &none           &kp N1          &kp N2          &kp N3          &none
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans		      &trans          &trans          &kp N0
			>;
		};
    
		sym_layer {
			label= "SYM";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
        &none           &kp EQUAL       &kp PLUS        &kp SEMI        &kp COLON           &none           &none           &none           &none           &none            
        &kp LBRC        &kp LPAR        &kp RPAR        &kp RBRC        &kp MINUS           &sk LGUI        &sk LCTRL       &sk LALT        &kp LSHFT       &none            
        &kp LT          &kp LBKT        &kp RBKT        &kp GT          &kp UNDER           &none           &none           &none           &none           &none            
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans		      &trans          &trans		      &trans
			>;
		};

		sym_2_layer {
			label= "SYM2";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
        &none           &kp GRAVE       &kp TILDE       &kp SQT         &kp DQT             &none           &none           &none           &none           &none            
        &kp PRCNT       &kp CARET       &kp AMPS        &kp ASTRK       &kp BSLH            &sk LGUI        &sk LCTRL       &sk LALT        &kp LSHFT       &none            
        &kp EXCL        &kp AT          &kp HASH        &kp DLLR        &kp PIPE            &none           &none           &none           &none           &none            
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans		      &trans          &trans		      &trans
			>;
		};

		func_layer {
			label= "FUNC";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&none           &trans          &vsc_mov_up     &trans          &none               &none           &none           &none           &none           &none
				&none           &vsc_mov_lf     &vsc_mov_dn     &vsc_mov_ri     &none               &none           &none           &none           &none           &none
				&none           &none           &none           &none           &none               &none           &none           &none           &none           &none
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans          &trans          &trans          &trans
			>;
		};

		func_2_layer {
			label= "FUNC2";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&none           &trans          &vsc_mov_up     &trans          &none               &none           &none           &none           &none           &none
				&none           &vsc_mov_lf     &vsc_mov_dn     &vsc_mov_ri     &none               &none           &none           &none           &none           &none
				&none           &none           &none           &none           &none               &none           &none           &none           &none           &none
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans          &trans          &trans          &trans
			>;
		};

		settings_layer {
			label= "SET";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&bootloader     &none           &out OUT_TOG    &bt BT_CLR      &bt BT_SEL 0        &bt BT_SEL 3    &none           &none           &tog MAC_TOGGLE &bootloader
				&none           &none           &out OUT_BLE    &none           &bt BT_SEL 1        &bt BT_SEL 4    &none           &none           &none           &none
				&studio_unlock  &none           &out OUT_USB    &none           &bt BT_SEL 2        &bt BT_SEL 5    &none           &none           &none           &studio_unlock
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&none           &none           &none           &none
			>;
		};

		mac_toggle_layer {
			label= "MAC TOGGLE";
			bindings = <
			    //              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans          &trans          &trans          &trans
			>;
		};

		mac_overlay_layer {
			label= "MAC OVERLAY";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans          &mt LGUI TAB    &lt FUNC F18    &lt NAV F18
			>;
		};

		mac_nav_layer {
			label= "MAC NAV";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans          &trans          &trans          &trans
      >;
    };

		mac_num_layer {
			label= "MAC NUM";
			bindings = <
				//              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				&trans          &trans          &trans          &trans          &trans              &trans          &trans          &trans          &trans          &trans
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans          &trans          &trans          &trans
      >;
    };

		mac_sym_layer {
			label= "MAC SYM";
			bindings = <
			  //              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&kp LG(W)       &kp LG(PG_UP)   &m_vsc_fcs_up   &kp LG(PG_DN)   &none               &none           &trans          &trans          &trans	        &trans
				&mo FUNC2       &m_vsc_fcs_lf   &m_vsc_fcs_dn   &m_vsc_fcs_ri   &none               &none           &trans          &trans          &trans          &trans
				&none           &kp LG(T)       &kp LG(N)       &kp LG(LS(N))   &none               &none           &trans          &trans          &trans          &trans
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans          &trans          &trans          &trans
			>;
    };
    
    mac_sym_2_layer {
			label= "MAC SYM 2";
			bindings = <
			  //              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&kp LG(W)       &kp LG(PG_UP)   &m_vsc_fcs_up   &kp LG(PG_DN)   &none               &none           &trans          &trans          &trans	        &trans
				&mo FUNC2       &m_vsc_fcs_lf   &m_vsc_fcs_dn   &m_vsc_fcs_ri   &none               &none           &trans          &trans          &trans          &trans
				&none           &kp LG(T)       &kp LG(N)       &kp LG(LS(N))   &none               &none           &trans          &trans          &trans          &trans
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans          &trans          &trans          &trans
			>;
    };

		mac_func_layer {
			label= "MAC FUNC";
			bindings = <
			  //              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&kp LG(W)       &kp LG(PG_UP)   &m_vsc_fcs_up   &kp LG(PG_DN)   &none               &none           &trans          &trans          &trans	        &trans
				&mo FUNC2       &m_vsc_fcs_lf   &m_vsc_fcs_dn   &m_vsc_fcs_ri   &none               &none           &trans          &trans          &trans          &trans
				&none           &kp LG(T)       &kp LG(N)       &kp LG(LS(N))   &none               &none           &trans          &trans          &trans          &trans
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans          &trans          &trans          &trans
			>;
    };

		mac_func_2_layer {
			label= "MAC FUNC 2";
			bindings = <
        //              ╷               ╷               ╷               ╷               ╷   ╷               ╷               ╷               ╷               ╷               ╷
				&none           &trans          &m_vsc_mov_up   &trans          &none               &none           &none           &none           &none           &none
				&none           &m_vsc_mov_lf   &m_vsc_mov_dn   &m_vsc_mov_ri   &none               &none           &none           &none           &none           &none
				&none           &none           &none           &none           &none               &none           &none           &none           &none           &none
				//left outter   ╷left inner     ╷right inner    ╷right outter   ╷
				&trans          &trans          &trans          &trans
			>;
		};
	};
};
