LAYER(Settings,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
		&bootloader   &out OUT_TOG  &out OUT_BLE  &out OUT_USB  XXX         ,   XXX           XXX           XXX           XXX           XXX         ,
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
		BT_CLEAR      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 5  XXX         ,   XXX           TOGGLE_MAC    XXX           XXX           BOOTLOADER  ,
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
		XXX           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  XXX         ,   XXX           XXX           XXX           XXX           XXX         ,
