ZMK_CONDITIONAL_LAYER(mac_base,      MAC_TOGGLE, MAC_OVERLAY)
ZMK_CONDITIONAL_LAYER(mac_nav,  NAV  MAC_TOGGLE, MAC_NAV    )
ZMK_CONDITIONAL_LAYER(mac_num,  NUM  MAC_TOGGLE, MAC_NUM    )
ZMK_CONDITIONAL_LAYER(mac_func, FUNC MAC_TOGGLE, MAC_FUNC   )


#define LAYER(NAME, LT, RT, LM, RM, LB, RB, TH)  ZMK_LAYER(NAME, LT RT LM RM LB RB TH)

LAYER(Base,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
		&kp Q         &kp W         &kp E         &kp R         &kp T       ,   &kp Y         &kp U         &kp I         &kp O         &kp SLASH   ,
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
		&kp A         &kp S         &kp D         &kp F         &kp G       ,   &kp H         &kp J         &kp K         &kp L         &kp P       ,
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
		&kp Z         &kp X         &kp C         &kp V         &kp B       ,   &kp B         &kp N         &kp M         &kp COMMA     &kp DOT     ,
//╰─────────────┼─────────────┴─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴───────────────────────────╯
																							&lt NAV SPACE &sk LCTRL       &sk LSHFT     &lt NUM LANG1
//                                          ╰─────────────┴─────────────╯ ╰─────────────┴─────────────╯
)

#define WIN_CAPTURE &kp LS(LG(S))
LAYER(Nav,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
		___           &kp LBKT      &lpar_lt      &rpar_gt      &kp RBKT    ,   &kp ESC       &kp TAB       &kp ENTER     &kp BACKSPACE &kp DEL     ,
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LSHFT     HRM_LA(SEMI)  HRM_LS(MINUS) HRM_LC(EQUAL) &kp LGUI    ,   &kp SPACE     &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT   ,
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           &kp SQT       &kp GRAVE     &kp BSLH      ___         ,   WIN_CAPTURE   &kp HOME      &kp PAGE_DOWN &kp PAGE_UP   &kp END     ,
//╰─────────────┼─────────────┴─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┴───────────────────────────╯
																							___           ___             ___           &kp LSHFT
//                                          ╰─────────────┴─────────────╯ ╰─────────────┴─────────────╯
)

LAYER(Num,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    XXX           &kp N7        &kp N8        &kp N9        &kp ENTER   ,   ___           ___           ___           ___           ___         ,
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp N0        &kp N4        &kp N5        &kp N6        &kp DOT     ,   &kp RGUI      &kp RCTRL     &kp RSHFT     &kp RALT      &sl FUNC    ,
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    XXX           &kp N1        &kp N2        &kp N3        XXX         ,   ___           ___           ___           ___           ___         ,
