#define BASE        0
#define NAV         1
#define NUM         2
#define FUNC        3
#define SETTINGS    4
#define MAC_TOGGLE  5
#define MAC_OVERLAY 6
#define MAC_NAV     7
#define MAC_NUM     8
#define MAC_FUNC    9

#define ALL_LAYERS \
  BASE NAV NUM FUNC SETTINGS \
  MAC_TOGGLE MAC_OVERLAY MAC_NAV MAC_NUM MAC_FUNC 


#define ___ &trans
#define XXX &none

#define QUICK_TAP_MS        100
#define TAPPING_TERM_MS     135
#define HRM_TAPPING_TERM_MS 300
#define HRM_QUICK_TAP_MS    100
#define HRM_PRIOR_IDLE_MS   75
#define STICKY_RELEASE_MS   350


#include "custom-behaviors.dtsi"
#include "homerow-mods.dtsi"

#include "combos.dtsi"
