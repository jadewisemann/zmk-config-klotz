if SHIELD_KLOTZ_LEFT

    config ZMK_KEYBOARD_NAME
        default "KLOTZ"

    # ZMK_SPLIT_ROLE_CENTRAL rather than the legacy ZMK_SPLIT_BLE_ROLE_CENTRAL:
    # the legacy symbol *selects* the role, so a dongle-mode build could not
    # turn it back off with CONFIG_ZMK_SPLIT_ROLE_CENTRAL=n.
    config ZMK_SPLIT_ROLE_CENTRAL
        default y

endif # LEFT

if SHIELD_KLOTZ_LEFT || SHIELD_KLOTZ_RIGHT

    config ZMK_SPLIT
        default y

endif # LEFT RIGHT

if ZMK_BACKLIGHT

    config PWM
        default y

    config LED_PWM
        default y

endif # ZMK_BACKLIGHT
